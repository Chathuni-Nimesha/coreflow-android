<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Coreflow.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/coreflow_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Coreflow.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/coreflow_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Coreflow.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/coreflow_on_surface</item>
    </style>

    <style name="TextAppearance.Coreflow.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/coreflow_on_surface_variant</item>
    </style>

    <style name="Widget.Coreflow.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/coreflow_primary</item>
        <item name="android:textColor">@color/coreflow_on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Coreflow.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/coreflow_outline</item>
        <item name="android:textColor">@color/coreflow_on_surface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Coreflow.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/coreflow_surface</item>
    </style>

    <style name="Widget.Coreflow.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/coreflow_primary</item>
        <item name="hintTextColor">@color/coreflow_on_surface_variant</item>
    </style>

    <style name="TextStyleHabit" parent="TextAppearance.Coreflow.Headline" />
    <style name="TextStyleLog" parent="TextAppearance.Coreflow.Body" />
    <style name="ToggleButton" parent="Widget.Coreflow.Button" />
    <style name="FloatActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/coreflow_primary</item>
        <item name="tint">@color/coreflow_on_primary</item>
    </style>

    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorControlActivated">@color/coreflow_primary</item>
        <item name="android:textColorPrimary">@color/coreflow_on_surface</item>
    </style>

    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/coreflow_on_surface_variant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalenderViewDateCustomText" parent="Widget.Material3.MaterialCalendar">
        <item name="android:textColor">@drawable/calendar_date_selector</item>
    </style>
</resources>
